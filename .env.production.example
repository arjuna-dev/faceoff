# Copy this file to .env.production and keep it outside version control.
# Generate the secret values with tools/generate_production_secrets.sh.

NAKAMA_DOMAIN=play.example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=nakama
POSTGRES_USER=nakama
POSTGRES_PASSWORD=replace-with-a-random-64-character-hex-value

NAKAMA_NODE_NAME=faceoff
# This key is embedded in release clients by configure_production_client.sh.
NAKAMA_SERVER_KEY=replace-with-a-random-64-character-hex-value
NAKAMA_SESSION_ENCRYPTION_KEY=replace-with-a-random-64-character-hex-value
NAKAMA_REFRESH_ENCRYPTION_KEY=replace-with-a-random-64-character-hex-value
NAKAMA_RUNTIME_HTTP_KEY=replace-with-a-random-64-character-hex-value
NAKAMA_CONSOLE_SIGNING_KEY=replace-with-a-random-64-character-hex-value
NAKAMA_CONSOLE_USERNAME=faceoff-admin
NAKAMA_CONSOLE_PASSWORD=replace-with-a-random-64-character-hex-value

BACKUP_DIR=/var/backups/faceoff
BACKUP_RETENTION_DAYS=14
# Optional off-host copy destinations:
# BACKUP_S3_URI=s3://bucket/faceoff/
# BACKUP_GCS_URI=gs://bucket/faceoff/

PROMETHEUS_RETENTION=15d
PROMETHEUS_PORT=9090

# Phone sign-in stays disabled until a Twilio Verify service is configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_CHANNEL=sms

# Protective local estimate for verification messages. The server stops new
# sends at the limit and surfaces an alert when the threshold is crossed.
# Configure Twilio's own billing alarms as the source of truth for the invoice.
FACE_OFF_SMS_BUDGET_EUR=10
FACE_OFF_SMS_ALERT_EUR=6
FACE_OFF_SMS_ESTIMATE_EUR=0.20
